# Experiential Labs OpenAI-compatible gateway. EXPLABS_API_KEY is the canonical key name.
EXPLABS_API_KEY=
# Optional compatibility alias.
EXPERIENTIAL_API_KEY=
# Either the host or the /v1 URL is accepted; ELIAS normalizes it.
EXPERIENTIAL_BASE_URL=https://api.experientiallabs.ai
# Optional: leave blank to load the live Experiential Labs model catalog automatically.
EXPERIENTIAL_MODEL=

# Hugging Face Inference Providers token for open-weight chat/media models.
# Fine-grained token with Inference Providers permission; keep server-only.
HF_TOKEN=
# Optional override from the live Hugging Face /v1/models catalog; default is Qwen/Qwen3.8-27B:fastest via HF.
HF_CHAT_MODEL=
# Optional text-to-image model, e.g. Qwen/Qwen-Image or black-forest-labs/FLUX.1-Krea-dev.
HF_IMAGE_MODEL=

# Exa live web search for current coding-agent and research evidence.
# Keep server-only; never expose with NEXT_PUBLIC_.
EXA_API_KEY=

QWEN_API_KEY=
AGENTROUTER_API_KEY=
# Cloudflare Workers AI (tried first). Reuses CLOUDFLARE_ACCOUNT_ID; token needs "Workers AI: Read".
# Falls back to CLOUDFLARE_API_TOKEN, then CLOUDFLARE_BROWSER_TOKEN. Optional: CLOUDFLARE_AGENT_MODEL, CLOUDFLARE_FAST_MODEL.
CLOUDFLARE_AI_TOKEN=
GROQ_API_KEY=
MISTRAL_API_KEY=
# GitHub OAuth App used only for Elias account sign-in.
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
# Separate GitHub OAuth App used only for repository access and write actions.
GITHUB_REPO_CLIENT_ID=
GITHUB_REPO_CLIENT_SECRET=

# Optional provider token for GitHub Models, if enabled.
GITHUB_TOKEN=

# Server-only Elias-owned Vercel MCP bridge. The URL defaults to the stable Elias route.
# VERCEL_MCP_URL=https://elias-ai-chi.vercel.app/api/mcp/vercel
# Secret used by Elias to call its own MCP bridge.
VERCEL_MCP_TOKEN=
# Personal Vercel API token used only by the bridge to call api.vercel.com.
VERCEL_API_TOKEN=

# Production durable task persistence. Supabase/Vercel Postgres integration supplies this in Vercel.
# Keep server-only; never expose it with NEXT_PUBLIC_.
POSTGRES_URL=

# Optional local or trusted-worker persistence. Used only when POSTGRES_URL is absent.
ELIAS_TASK_STORE_PATH=.elias/tasks.json
ELIAS_AUTOMATION_STORE_PATH=.elias/automations.json

# Keep false on ordinary Vercel functions. Enable only on an isolated trusted worker.
ELIAS_EXECUTION_ENABLED=false

# ---------- Elias assistant (/assistant) ----------
# Tool-calling agent provider order. "custom" uses any OpenAI-compatible endpoint below.
ELIAS_AGENT_PROVIDERS=custom,huggingface,groq,mistral
ELIAS_AGENT_BASE_URL=
ELIAS_AGENT_API_KEY=
ELIAS_AGENT_MODEL=
# Optional per-provider agent models.
HF_AGENT_MODEL=
GROQ_AGENT_MODEL=llama-3.3-70b-versatile
MISTRAL_AGENT_MODEL=mistral-large-latest
# Google (Gmail + Calendar). Create an OAuth client (Web) in Google Cloud and add
# https://<your-domain>/api/connect/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Scheduled tasks: secret for /api/cron/tick (Supabase pg_cron calls it every 5 min; Vercel Cron daily as backup).
CRON_SECRET=
# Real browser actions via Browserbase.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_KEEP_ALIVE=false
