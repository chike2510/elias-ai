# ============================================================
# ELIAS provider routing
# ============================================================
# Comma-separated preferred providers. Example:
# ELIAS_PROVIDER_ORDER=qwen,openrouter,cerebras,groq,agentrouter,mistral,github
ELIAS_PROVIDER_ORDER=qwen,openrouter,cerebras,groq,agentrouter,mistral,github

# Optional per-task preference.
ELIAS_CODE_PROVIDER=qwen
ELIAS_RESEARCH_PROVIDER=groq
ELIAS_GENERAL_PROVIDER=qwen

# ============================================================
# OpenAI-compatible providers
# ============================================================
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=
AGENTROUTER_MODEL=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=

GITHUB_MODELS_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=

# ============================================================
# Optional generic search adapter
# ============================================================
# If set, ELIAS /api/research can call your OpenAI-compatible
# research provider instead of using the Groq model.
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARCH_MODEL=

# Optional Cohere utilities for future RAG/reranking
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2