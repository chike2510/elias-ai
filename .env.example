QWEN_API_KEY=
AGENTROUTER_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=

# Server-only Vercel MCP bridge. Do not expose either value to the browser.
# Example: https://your-vercel-mcp-server.example.com/api/mcp
VERCEL_MCP_URL=
# Supply either a complete Authorization value (for example: Bearer <token>)
# or a raw token that will be sent as Bearer authentication.
VERCEL_MCP_AUTHORIZATION=
VERCEL_MCP_TOKEN=

# Optional local or trusted-worker persistence. On Vercel, use a database adapter for shared durability.
ELIAS_TASK_STORE_PATH=.elias/tasks.json

# Keep false on ordinary Vercel functions. Enable only on an isolated trusted worker.
ELIAS_EXECUTION_ENABLED=false
