QWEN_API_KEY=
AGENTROUTER_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=

# Server-only Elias-owned Vercel MCP bridge. The URL defaults to the stable Elias route.
# VERCEL_MCP_URL=https://elias-ai-chi.vercel.app/api/mcp/vercel
# Secret used by Elias to call its own MCP bridge.
VERCEL_MCP_TOKEN=
# Personal Vercel API token used only by the bridge to call api.vercel.com.
VERCEL_API_TOKEN=

# Optional local or trusted-worker persistence. On Vercel, use a database adapter for shared durability.
ELIAS_TASK_STORE_PATH=.elias/tasks.json

# Keep false on ordinary Vercel functions. Enable only on an isolated trusted worker.
ELIAS_EXECUTION_ENABLED=false
