{"id": "read-grep", "category": "read", "input": "Where is the greeting defined in acme/app?", "repo": {"files": {"README.md": "# App\n", "src/greet.ts": "export function greet(name: string) {\n  return `Hi ${name}`;\n}\n", "src/app.ts": "import { greet } from './greet';\n\nconsole.log(greet('Ada'));\n"}}, "script": [{"tool": "repo_tree", "args": {"repo": "acme/app"}}, {"tool": "repo_grep", "args": {"pattern": "function greet"}}, {"tool": "repo_read", "args": {"path": "src/greet.ts"}}], "reply": "It's in src/greet.ts.", "expect": {"tools": ["repo_tree", "repo_grep", "repo_read"], "noWrites": true, "stagedFiles": 0, "outputMatches": {"tool": "repo_grep", "pattern": "src/greet.ts"}}}
{"id": "edit-ship", "category": "ship", "input": "Change the greeting to Hello in acme/app and check CI", "repo": {"files": {"README.md": "# App\n", "src/greet.ts": "export function greet(name: string) {\n  return `Hi ${name}`;\n}\n", "src/app.ts": "import { greet } from './greet';\n\nconsole.log(greet('Ada'));\n"}}, "script": [{"tool": "repo_tree", "args": {"repo": "acme/app"}}, {"tool": "repo_read", "args": {"path": "src/greet.ts"}}, {"tool": "code_edit", "args": {"path": "src/greet.ts", "edits": [{"find": "return `Hi ${name}`;", "replace": "return `Hello ${name}`;"}]}}, {"tool": "code_diff"}, {"tool": "code_commit", "args": {"message": "Update greeting"}}, {"tool": "code_verify"}], "reply": "Done: changes are on the branch.", "expect": {"tools": ["repo_tree", "repo_read", "code_edit", "code_diff", "code_commit", "code_verify"], "executed": ["code_edit", "code_commit", "code_verify"], "branchFile": {"path": "src/greet.ts", "includes": "Hello ${name}"}, "mainUnchanged": true, "card": "diff", "ci": "passed", "approval": null, "stagedFiles": 0}}
{"id": "patch-multi-file", "category": "ship", "input": "Add a shout helper and use it in app.ts", "repo": {"files": {"README.md": "# App\n", "src/greet.ts": "export function greet(name: string) {\n  return `Hi ${name}`;\n}\n", "src/app.ts": "import { greet } from './greet';\n\nconsole.log(greet('Ada'));\n"}}, "script": [{"tool": "repo_tree", "args": {"repo": "acme/app"}}, {"tool": "code_patch", "args": {"diff": "--- a/src/app.ts\n+++ b/src/app.ts\n@@ -1,3 +1,4 @@\n import { greet } from './greet';\n+import { shout } from './util';\n \n-console.log(greet('Ada'));\n+console.log(shout(greet('Ada')));\n--- /dev/null\n+++ b/src/util.ts\n@@ -0,0 +1,1 @@\n+export const shout = (text: string) => text.toUpperCase();\n"}}, {"tool": "code_commit", "args": {"message": "Add shout helper"}}, {"tool": "code_verify"}], "reply": "Done: changes are on the branch.", "expect": {"executed": ["code_patch", "code_commit", "code_verify"], "branchFile": {"path": "src/util.ts", "includes": "toUpperCase"}, "mainUnchanged": true, "ci": "passed"}}
{"id": "ci-fail-then-fix", "category": "verify", "input": "Rename greet's output and make sure CI passes", "repo": {"files": {"README.md": "# App\n", "src/greet.ts": "export function greet(name: string) {\n  return `Hi ${name}`;\n}\n", "src/app.ts": "import { greet } from './greet';\n\nconsole.log(greet('Ada'));\n"}, "failIf": "BROKEN"}, "script": [{"tool": "repo_tree", "args": {"repo": "acme/app"}}, {"tool": "code_edit", "args": {"path": "src/greet.ts", "edits": [{"find": "return `Hi ${name}`;", "replace": "return BROKEN;"}]}}, {"tool": "code_commit", "args": {"message": "Try"}}, {"tool": "code_verify"}, {"tool": "code_edit", "args": {"path": "src/greet.ts", "edits": [{"find": "return BROKEN;", "replace": "return `Hey ${name}`;"}]}}, {"tool": "code_commit", "args": {"message": "Fix build"}}, {"tool": "code_verify"}], "reply": "Done: changes are on the branch.", "expect": {"executed": ["code_verify"], "outputMatches": {"tool": "code_verify", "pattern": "TS2304"}, "ci": "passed", "attempts": 0, "branchFile": {"path": "src/greet.ts", "includes": "Hey ${name}"}, "mainUnchanged": true}}
{"id": "ci-gives-up-after-4", "category": "verify", "input": "Make greet return BROKEN and keep trying", "repo": {"files": {"README.md": "# App\n", "src/greet.ts": "export function greet(name: string) {\n  return `Hi ${name}`;\n}\n", "src/app.ts": "import { greet } from './greet';\n\nconsole.log(greet('Ada'));\n"}, "failIf": "BROKEN"}, "script": [{"tool": "repo_tree", "args": {"repo": "acme/app"}}, {"tool": "code_edit", "args": {"path": "src/greet.ts", "edits": [{"find": "return `Hi ${name}`;", "replace": "return BROKEN; // 1"}]}}, {"tool": "code_commit", "args": {"message": "Attempt 1"}}, {"tool": "code_verify"}, {"tool": "code_edit", "args": {"path": "src/greet.ts", "edits": [{"find": "return BROKEN; // 1", "replace": "return BROKEN; // 2"}]}}, {"tool": "code_commit", "args": {"message": "Attempt 2"}}, {"tool": "code_verify"}, {"tool": "code_edit", "args": {"path": "src/greet.ts", "edits": [{"find": "return BROKEN; // 2", "replace": "return BROKEN; // 3"}]}}, {"tool": "code_commit", "args": {"message": "Attempt 3"}}, {"tool": "code_verify"}, {"tool": "code_edit", "args": {"path": "src/greet.ts", "edits": [{"find": "return BROKEN; // 3", "replace": "return BROKEN; // 4"}]}}, {"tool": "code_commit", "args": {"message": "Attempt 4"}}, {"tool": "code_verify"}, {"tool": "code_verify"}], "reply": "CI still fails after 4 attempts; here's what's left.", "expect": {"attempts": 4, "ci": "failed", "outputMatches": {"tool": "code_verify", "pattern": "(Stop editing|failed 4 times)"}, "mainUnchanged": true}}
